{
  "name": "@bencmbrook/aes_gcm_stream",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "WebAssembly-powered streaming AES-256-GCM implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./stream": {
      "import": "./dist/stream.js",
      "types": "./dist/stream.d.ts"
    }
  },
  "files": [
    "dist/",
    "pkg/aes_gcm_stream_wasm_bg.wasm",
    "pkg/aes_gcm_stream_wasm.js",
    "pkg/aes_gcm_stream_wasm.d.ts"
  ],
  "scripts": {
    "build": "npm run build:rust && npm run build:js",
    "build:rust": "cd rust && wasm-pack build --target web --out-dir ../pkg && rm ../pkg/.gitignore",
    "build:js": "tsc --project tsconfig.json",
    "test": "npm run test:rust && npm run test:js",
    "test:rust": "cd rust && wasm-pack test --node",
    "test:js": "web-test-runner --node-resolve",
    "clean": "rm -rf pkg/ target/ dist/ rust/target/",
    "prepublishOnly": "npm run build",
    "lint": "pnpm run --parallel --aggregate-output \"/^lint:*/\"",
    "lint:prettier": "prettier --check . --log-level warn",
    "lint:types": "tsc --noEmit",
    "lint:test-types": "tsc --noEmit --project test/tsconfig.json",
    "lint:eslint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "aes",
    "gcm",
    "streaming",
    "webassembly",
    "wasm",
    "web-streams",
    "encryption",
    "crypto"
  ],
  "author": "Ben Brook",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.2",
    "eslint": "^9.32.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "prettier": "^3.6.2",
    "tinybench": "^4.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
