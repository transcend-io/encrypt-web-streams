{
  "name": "@transcend-io/encrypt-web-streams",
  "version": "0.3.0",
  "description": "WebAssembly-powered streaming AES-256-GCM encryption and decryption with a web-native TransformStream API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./stream": {
      "import": "./dist/stream.js",
      "types": "./dist/stream.d.ts"
    }
  },
  "files": [
    "dist/",
    "wasm/aes_gcm_stream_wasm_bg.wasm",
    "wasm/aes_gcm_stream_wasm.js",
    "wasm/aes_gcm_stream_wasm.d.ts"
  ],
  "scripts": {
    "build": "npm run build:rust && npm run build:js",
    "build:rust": "cd rust && wasm-pack build --target web --out-dir ../wasm && rm ../wasm/.gitignore",
    "build:js": "tsc --project tsconfig.json",
    "test:rust": "pnpm build && pnpm run test:rust:ci",
    "test:js": "pnpm build && pnpm run test:js:ci",
    "test:fixtures": "pnpm build && pnpm run test:fixtures:ci",
    "test:rust:ci": "cd rust && wasm-pack test --node && cargo test",
    "test:js:ci": "web-test-runner --node-resolve --playwright --browsers chromium firefox webkit --files test/**/*.test.ts --files !test/speed.test.ts --files !test/fixtures.test.ts",
    "test:fixtures:ci": "bash test-fixtures.sh",
    "rebuild-fixtures": "tsx test/fixtures/rebuild-fixtures.ts",
    "benchmark": "web-test-runner --node-resolve --playwright --browsers chromium firefox webkit --files test/speed.test.ts",
    "clean": "rm -rf wasm/ dist/ rust/target/",
    "prepublishOnly": "npm run build",
    "lint": "pnpm run \"/^lint:.*/\"",
    "lint:prettier": "prettier --check . --log-level warn",
    "lint:eslint": "eslint .",
    "lint:types": "tsc --noEmit",
    "lint:types:tests": "tsc --noEmit --project test/tsconfig.json",
    "lint:types:fixtures": "tsc --noEmit --project test/fixtures/tsconfig.json",
    "format": "prettier --write ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@esm-bundle/chai": "4.3.4-fix.0",
    "@tsconfig/node22": "^22.0.2",
    "@tsconfig/strictest": "^2.0.5",
    "@types/node": "22.x",
    "@web/dev-server-esbuild": "^1.0.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-playwright": "^0.11.1",
    "eslint": "^9.32.0",
    "eslint-plugin-unicorn": "^60.0.0",
    "hash-wasm": "^4.12.0",
    "http-server": "^14.1.1",
    "mime": "^4.0.7",
    "prettier": "^3.6.2",
    "prettier-plugin-jsdoc": "^1.3.3",
    "pretty-bytes": "^7.0.0",
    "pretty-ms": "^9.2.0",
    "tinybench": "^4.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "wasm-pack": "^0.13.1"
  },
  "author": "Ben Brook",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "keywords": [
    "aes",
    "gcm",
    "streaming",
    "webassembly",
    "typescript",
    "javascript",
    "wasm",
    "web-streams",
    "web",
    "web-native",
    "encryption",
    "crypto"
  ]
}
